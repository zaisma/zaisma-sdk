      "types": "./server.d.ts",
      "default": "./server.js"
    },
    "./piece.json": "./piece.json"
  },
  "files": [
    "LICENSE.txt",
    "README.md",
    "core.js",
    "index.d.ts",
    "index.js",
    "kinds/characters.js",
    "kinds/define.js",
    "kinds/events.js",
